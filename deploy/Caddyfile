# Caddy obtains and renews a Let's Encrypt certificate automatically. It needs
# DOMAIN to resolve to this VM's public IP before it can complete the ACME
# challenge — point DNS first, then start the stack.
#
# DOMAIN and ACME_EMAIL come from deploy/stellargate.env.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy defaults to TLS 1.2+ already; pinned explicitly so a future Caddy
	# default change can't silently reopen 1.0/1.1 for a service handling
	# payment data.
	tls {
		protocols tls1.2 tls1.3
	}

	# /metrics is gated app-side by METRICS_TOKEN (unset by default, which
	# denies every request), but this VM has no other network boundary
	# between the public internet and the app container — so the path is
	# blocked here too, by default, rather than relying on the app-side gate
	# alone (issue #250). To scrape from outside the Docker network instead,
	# remove this block and set METRICS_TOKEN in deploy/stellargate.env.
	@metrics path /metrics /v1/metrics
	respond @metrics 404

	# /ready and /health are liveness/readiness probes for the orchestrator.
	# They are unauthenticated and exempt from the app-side rate limiter, and
	# /ready contacts Horizon — so exposing them publicly lets anonymous
	# callers drive outbound Horizon traffic (issue #888). Probes should hit
	# the container directly on the Docker network; block them here by
	# default. To allow external monitoring, remove this block deliberately.
	@probes path /ready /health
	respond @probes 404

	# The gateway is not published on a host port; this is the only route in.
	reverse_proxy app:3000 {
		# Preserve the client IP. The rate limiter and the auth failure logs
		# key on it, so without these every request would appear to come from
		# the proxy and one noisy client would rate-limit everybody.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# HSTS: this service handles API keys and payment data, so never allow
		# a downgrade to plaintext once a browser has seen it over TLS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		# This is a JSON API with no camera/mic/geolocation surface of its
		# own; deny every browser feature a client might otherwise inherit.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The dashboard sets its own CSP per-response; don't override it here.
		-Server
		# The app owns Referrer-Policy (no-referrer) and X-Content-Type-Options
		# (nosniff) on every response via SetResponseHeaderLayer::overriding.
		# Do not set them here: Caddy's `header Field value` form would replace
		# the app's stricter value. If a proxy-level fallback is ever needed,
		# use the `?Field value` form so upstream values win.
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
